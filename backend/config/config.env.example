# Copy to config.env (gitignored) and fill in real values.

PORT=4000
NODE_ENV=DEVELOPMENT

# MongoDB
DB_LOCAL_URI=mongodb://127.0.0.1:27017/sudamarket

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Phone numbers without a country code are parsed as this country (ISO 3166-1 alpha-2)
DEFAULT_COUNTRY=EG

# SMS gateway used for OTP codes. Leave SMS_API_KEY empty in development to
# print codes to the console instead of sending them.
SMS_BASE_URL=https://mazinhost.com/smsv1/sms/api
SMS_API_KEY=
SMS_SENDER=SudaMarket

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000

# Where uploaded images are saved (served at /uploads). Defaults to <project>/uploads
UPLOAD_DIR=
